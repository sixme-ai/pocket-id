# The first input contains the public profile generated by start.sh.
# The second uses the installer's literal KEY=value format. Never log its contents.
BEGIN { FS = "=" }
FILENAME == ARGV[1] { expected[$1] = $0; next }
/^[[:space:]]*(#.*)?$/ { next }
{
    key = $1
    if (++seen[key] != 1) invalid = 1
    if (key in expected) {
        if ($0 != expected[key]) invalid = 1
    } else if (key == "ENCRYPTION_KEY" || key == "STATIC_API_KEY") {
        # These per-installation secrets are generated as single unquoted hex values.
        if ($0 !~ /^[A-Z_]+=[0-9a-f]+$/ || length($2) != 64) invalid = 1
    } else {
        invalid = 1
    }
}
END {
    for (key in expected) if (seen[key] != 1) invalid = 1
    if (seen["ENCRYPTION_KEY"] != 1 || seen["STATIC_API_KEY"] != 1) invalid = 1
    exit invalid ? 1 : 0
}
